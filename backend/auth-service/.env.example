AUTH_SERVICE_NAME=Enterprise Workforce Authentication Service
AUTH_ENVIRONMENT=development
AUTH_DATABASE_URL=sqlite:///./auth_service.db
AUTH_JWT_SECRET_KEY=development-only-change-this-secret-key
